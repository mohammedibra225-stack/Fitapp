# Configuration du serveur
API_HOST=0.0.0.0
API_PORT=8000

# Langue de repli utilisee par le systeme de traduction
DEFAULT_LANGUAGE=fr

# --- Base de donnees Neon PostgreSQL ---
# Recuperez cette chaine depuis le dashboard Neon (Connection Details).
# Format : postgresql://<user>:<password>@<host>/<dbname>
# Ne jamais commit ce fichier une fois rempli (voir .gitignore) et
# ne jamais mettre cette URL dans le code React Native / Expo.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/fitapp

# --- Spoonacular Recipe API ---
# Ne jamais mettre cette clé dans Expo ou dans le dépôt Git.
SPOONACULAR_API_KEY=your_spoonacular_api_key

# --- Ollama (AI Meal Analysis, vision locale) ---
# Ollama tourne en local : aucune cle API, rien de secret ici.
# L'URL peut pointer vers une autre machine du reseau si besoin.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=400
AI_IMAGE_MAX_DIMENSION=768

# --- Hugging Face (analyse de photos de repas, quota ZeroGPU) ---
# Facultatif mais fortement recommande : sans token, le quota ZeroGPU
# anonyme s'epuise tres vite ("You have exceeded your ZeroGPU runs limit").
# Cree un token role "read" sur https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token

# Quota quotidien d'analyses de repas par utilisateur (garde-fou CPU).
AI_MAX_MEAL_ANALYSES_PER_DAY=30

# --- Kie AI (Assistant Conversationnel GPT-6 Astra) ---
# Ne jamais exposer cette cle au frontend ou dans le depot Git.
KIE_API_KEY=your_kie_api_key
KIE_API_URL=https://api.kie.ai/codex/v1/responses
KIE_MODEL=gpt-6-astra
KIE_TIMEOUT_SECONDS=45
